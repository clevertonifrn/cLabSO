alias bar="source ~/.bash_aliases"

alias df="df -h"
alias ls="ls --color" 
alias la="ls -lha --group-directories-first"
alias lat="ls -lha -tr"
alias grep="grep --color"

alias pipi="pip3.11 install --break-system-packages"
alias py="python3"

alias pico="nano"

#Git
alias gts="git status -sb"
alias gts1w="gitCommitStats.sh 1"
alias gts3w="gitCommitStats.sh 3"
alias gtsw="git log --oneline --since='last sunday' | wc -l"
alias gtsd="git log --oneline --since=1.day | wc -l"
alias gtst="git log --oneline --since='1am' | wc -l"
alias gtsz="git count-objects -vH"
alias gtc="git commit"
alias gta="git add"
alias gtau="git add -u"
alias gtp="git push"
alias gtd="git diff --stat"
alias gtdl="git diff HEAD"
alias gtdh="git diff @~..@" #Diff Head e o último commmit
alias gtl="git log --stat --pretty=format:'%Cblue%h%Creset - %ar : %Cred%s %C(yellow)(%G?)'"
alias gtls="git log --date=format:'%a %d/%m/%y' --pretty=format:'%Cblue%h%Creset %Cred%cd%Creset %s'"
alias gtld="git log --stat --since=1.day --pretty=format:'%Cblue%h%Creset - %ar : %Cred%s %C(yellow)(%G?)'"
alias gtlt="git log --stat --since='1am' --pretty=format:'%Cblue%h%Creset - %ar : %Cred%s %C(yellow)(%G?)'"
alias gtlw="git log --since='last sunday' --date=format:'%a %d/%m/%y' --pretty=format:'%Cblue%h%Creset %Cred%cd%Creset %s'"
alias gtrev="git checkout --"
alias gtb="git checkout "
alias gtbr="git branch -a "
alias gtbrd="git push origin -d "
alias gtbm="git checkout main"
alias gtbn="git checkout -b "
alias gtbd="gtbm; git branch -D "
alias gtbl="git branch"
alias gtm="git merge "
alias gtt="git stash push "
alias gttl="git stash list"
alias gttp="git stash pop "
alias gtrrm="git rm --cached -r"
alias gtrst="git reset --hard HEAD"
alias gtg="git tag"
alias gtgl="git log --oneline --decorate --tags --no-walk"
alias gtfp="git fetch; git pull"
alias gtgu="git remote get-url origin"

#Todo.sh
alias td="todo.sh"
alias tda="todo.sh add"
alias tdl="todo.sh list"

#Opencode
alias ocs="opencode"
alias oc="opencode --standalone"
alias ocr="oc run"