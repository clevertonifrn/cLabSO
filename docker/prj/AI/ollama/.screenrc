# Info from https://github.com/DXist/dotfiles/blob/2d95cd24ea5600f1078707a995b19a944fc944d7/.screenrc

# An alternative hardstatus to display a bar at the bottom listing the
# windownames and highlighting the current windowname in blue. (This is only
# enabled if there is no hardstatus setting for your terminal)
hardstatus on
hardstatus alwayslastline
#hardstatus string "%{.bW}%-w%{.rW}%n %t%{-}%+w %=%{..G} %H %{..Y} %m/%d %C%a "

#From https://gist.github.com/joaopizani/2718397
#hardstatus string '%{= kG}[%{G}%H%? %1`%?%{g}][%= %{= kw}%-w%{+b yk} %n*%t%?(%u)%? %{-}%+w %=%{g}][%{B}%m/%d %{W}%C%A%{g}]'
#hardstatus string '%{= kG}%{= kw}%-w%{+b yk} %n*%t%?(%u)%? %{-}%+w %=%{g}%{= kG}[%{G}%H%? %1`%?%{g}(%l) %{B}%m/%d %{W}%C%A%{g}]'
#hardstatus string '%{= kG}%{= kw}%-w%{+b yk} %n*%t%?(%u)%? %{-}%+w %=%{g}%{= kG}[%{G}%H%? %1`%?%{g}(%l) %{B}%m/%d %{W}%C%A%{g}]'

backtick 1 2 30 /bin/sh -c "free -m | grep Mem | awk '{ print \$3 \" Free:\" \$4 }' "
#hardstatus string "%{.kW}%-w%{.bW}%t [%n]%{-}%+w %= %{..R} Mem: %1` Mb %{..G} %H %{..Y} %Y/%m/%d %c"
hardstatus string '%{= kG}%{= kw}%-w%{+b yk} %n*%t%?(%u)%? %{-}%+w %=%{g}%{= kG}[%{G}%H%? %?%{g}(%l / Mem:%1` M) %{B}%m/%d %{W}%C%A%{g}]'


# huge scrollback buffer
defscrollback 3000

# no welcome message
startup_message off

# 256 colors
attrcolor b ".I"
termcapinfo xterm 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'
defbce on

# mouse tracking allows to switch region focus by clicking
mousetrack on

# Mouse scroll - https://stackoverflow.com/questions/359109/using-the-scrollwheel-in-gnu-screen
termcapinfo xterm* ti@:te@

# default windows
# default windows
screen -t OllamaS 1 sh -c 'ollama serve'
screen -t OllamaC 2 bash
select 1

bind c screen 1 # window numbering starts at 1 not 0
bind 0 select 10

# QuickRef http://aperiodic.net/screen/quick_reference
# get rid of silly xoff stuff
#Split Horiz
bind S 
bind o split #Split Horiz

#Split Vert
bind |
bind e split -v

#Remove
bind w remove

#Remove Scrollback mode
bind [

# navigating regions with Ctrl-arrows
bindkey "^[[1;5D" focus left
bindkey "^[[1;5C" focus right
bindkey "^[[1;5A" focus up
bindkey "^[[1;5B" focus down
